{
  "version": "0.2.0",
  "configurations": [

   {
      "name": "Uvicorn: Debug (single process)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.suggest_service:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8100",
        "--workers",
        "1",
        "--reload"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
  ]
}
